{
  "mcpServers": {
    "chrome": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect"]
    },    
    "mcp-python-interpreter": {
        "command": "uvx",
        "args": [
            "--with", "mcp<2",
            "mcp-python-interpreter",
            "--dir",
            "./python_auto_gen",
            "--python-path",
            "python"
        ],
        "env": {
            "MCP_ALLOW_SYSTEM_ACCESS": "0"
        }
    },
    "shell": {
      "command": "npx",
      "args": ["-y", "@supercorp/shell-mcp", "--transport", "stdio"]
    }
  }
}
